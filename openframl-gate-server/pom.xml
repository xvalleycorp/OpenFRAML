<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>vn.io.dxa.openframl</groupId>
    <artifactId>openframl-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>openframl-gate-server</artifactId>
  <name>OpenFRAML Gate Service</name>
  <description>
    The gate as a gRPC service: the API in openframl/gate/v1/gate.proto, the caller's deadline as the gate's time
    budget.
  </description>
  <url>https://github.com/xvalleycorp/OpenFRAML/tree/main/openframl-gate-server</url>

  <dependencies>
    <dependency>
      <groupId>vn.io.dxa.openframl</groupId>
      <artifactId>openframl-gate</artifactId>
    </dependency>
    <dependency>
      <groupId>vn.io.dxa.openframl</groupId>
      <artifactId>openframl-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>vn.io.dxa.openframl</groupId>
      <artifactId>openframl-valkey</artifactId>
    </dependency>
    <dependency>
      <groupId>vn.io.dxa.openframl</groupId>
      <artifactId>openframl-onnx</artifactId>
    </dependency>
    <!-- Sends the Kafka client's logs to java.util.logging, like the gate's own -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Country packs are chosen at start-up; Vietnam ships with the server -->
    <dependency>
      <groupId>vn.io.dxa.openframl</groupId>
      <artifactId>openframl-vn</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-inprocess</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.github.ascopes</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <configuration>
          <protoc kind="binary-maven">
            <version>${protobuf.version}</version>
          </protoc>
          <plugins>
            <plugin kind="binary-maven">
              <groupId>io.grpc</groupId>
              <artifactId>protoc-gen-grpc-java</artifactId>
              <version>${grpc.version}</version>
            </plugin>
          </plugins>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
