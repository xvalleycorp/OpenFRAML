{
  "id": "gate_fallback",
  "version": "1",
  "description": "A fallback policy that fails at evaluation: it compares money in two currencies",
  "effectiveFrom": "2026-01-01",
  "hitPolicy": "FIRST",
  "inputs": { "transaction": { "amount": "money" } },
  "outputs": { "action": "string" },
  "rules": [
    { "id": "BROKEN", "when": "transaction.amount > money(1, 'EUR')", "then": { "action": "'ALLOW'" } }
  ]
}
