<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>vn.io.dxa.openframl</groupId>
    <artifactId>openframl-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>openframl-report</artifactId>
  <name>OpenFRAML Regulatory Reporting</name>
  <description>
    The reports a bank files with its financial intelligence unit: transactions that reach the country pack's legal
    thresholds, day by day, and suspicious transaction reports from the cases concluded as reported.
  </description>
  <url>https://github.com/xvalleycorp/OpenFRAML/tree/main/openframl-report</url>

  <dependencies>
    <dependency>
      <groupId>vn.io.dxa.openframl</groupId>
      <artifactId>openframl-model</artifactId>
    </dependency>
    <dependency>
      <groupId>vn.io.dxa.openframl</groupId>
      <artifactId>openframl-case</artifactId>
    </dependency>
    <!-- Also brings Jackson, used for the reports' JSON form at the version RuleStone is built with -->
    <dependency>
      <groupId>vn.io.dxa.rulestone</groupId>
      <artifactId>rulestone-core</artifactId>
    </dependency>
    <!-- ValueType, to check the threshold tables' declared output when the policy is built -->
    <dependency>
      <groupId>vn.io.dxa.rulestone</groupId>
      <artifactId>rulestone-cel</artifactId>
    </dependency>
    <!-- The thresholds are tested with the Vietnam pack's tables -->
    <dependency>
      <groupId>vn.io.dxa.openframl</groupId>
      <artifactId>openframl-vn</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
