{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openframl-website",
  "compatibility_date": "2026-10-01",
  // Static site only: no Worker script, every request is served from public/.
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "openframl.dxa.io.vn", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
